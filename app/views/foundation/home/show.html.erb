<% identity = Rails.configuration.x.foundation %>
<% title "Northwind Beacon — Incident alerts that reach your team" %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">When something breaks, Beacon finds your team.</h1>
      <p>Northwind Beacon turns alerts into reach. Route every incident to the right person on the right channel — Slack, email, SMS, or a phone call — with escalation that never sleeps.</p>
      <div class="md-actions">
        <%= link_to "Join the waitlist", "#waitlist", class: "md-button md-button--filled" %>
        <%= link_to "See pricing", "#pricing", class: "md-button md-button--outlined" %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="features-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Why Beacon</p>
    <h2 id="features-title" class="md-section__heading">Every alert finds the person who can act.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature" data-capability="routing">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:notifications, size: 32) %></span>
        <div>
          <h3>Smart routing</h3>
          <p>Beacon reads the alert, knows the service, and sends it to the on-call engineer — not the whole channel.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="escalation">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:trending_up, size: 32) %></span>
        <div>
          <h3>Escalation that escalates</h3>
          <p>Unacked after two minutes? Beacon moves up the chain automatically, with a full audit trail of who was paged and when.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="channels">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:send, size: 32) %></span>
        <div>
          <h3>Reach you already use</h3>
          <p>Slack, email, SMS, and voice calls out of the box — each contact gets the channel they actually answer.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="schedule">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:schedule, size: 32) %></span>
        <div>
          <h3>On-call schedules</h3>
          <p>Build rotations in minutes. Beacon knows who owns 3 AM on a Tuesday before the pager does.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="integrations">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:link, size: 32) %></span>
        <div>
          <h3>Plays well with your stack</h3>
          <p>Webhooks, PagerDuty-style APIs, and a REST API so alerts flow in from Datadog, Grafana, or your own scripts.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="reporting">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:analytics, size: 32) %></span>
        <div>
          <h3>Post-incident reports</h3>
          <p>Every page, ack, and escalation logged. Beacon turns noise into a report your team can actually learn from.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="md-section md-section--tonal" aria-labelledby="pricing-title" id="pricing">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Simple plans</p>
    <h2 id="pricing-title" class="md-section__heading">Start free, scale when your team does.</h2>
    <div class="md-pricing-grid">
      <article class="md-card md-card--outlined md-price-card">
        <h3>Starter</h3>
        <p>For a small team finding its footing.</p>
        <p class="md-price-card__price">Free</p>
        <ul>
          <li>5 teammates</li>
          <li>Email and Slack alerts</li>
          <li>One on-call schedule</li>
        </ul>
        <%= link_to "Join the waitlist", "#waitlist", class: "md-button md-button--outlined" %>
      </article>
      <article class="md-card md-card--elevated md-price-card">
        <span class="md-chip selected">Recommended</span>
        <h3>Growth</h3>
        <p>For teams that need the full rotation.</p>
        <p class="md-price-card__price">$19<span class="text-sm font-normal text-md-on-surface-variant">/user/month</span></p>
        <ul>
          <li>Unlimited teammates</li>
          <li>SMS and voice escalation</li>
          <li>Unlimited schedules</li>
          <li>Webhooks and API</li>
        </ul>
        <%= link_to "Join the waitlist", "#waitlist", class: "md-button md-button--filled" %>
      </article>
      <article class="md-card md-card--outlined md-price-card">
        <h3>Enterprise</h3>
        <p>For organizations with real uptime stakes.</p>
        <p class="md-price-card__price">Let's talk</p>
        <ul>
          <li>SSO and SAML</li>
          <li>Dedicated support</li>
          <li>Custom SLAs</li>
        </ul>
        <%= link_to "Contact sales", "#waitlist", class: "md-button md-button--outlined" %>
      </article>
    </div>
  </div>
</section>

<section class="md-section" aria-labelledby="faq-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Questions, answered</p>
    <h2 id="faq-title" class="md-section__heading">The things people ask before they join.</h2>
    <div class="md-faq">
      <details>
        <summary>What exactly is Beacon?</summary>
        <p>Beacon is an incident alerting service. It takes alerts from your monitoring stack, routes them to the right on-call person, and escalates until someone acknowledges.</p>
      </details>
      <details>
        <summary>How does the waitlist work?</summary>
        <p>Drop your email below and we'll invite you in batches as we open up. You'll hear from us before we launch.</p>
      </details>
      <details>
        <summary>Can I try it before paying?</summary>
        <p>Yes — the Starter plan is free forever for small teams. Upgrade to Growth when you need SMS, voice, or unlimited schedules.</p>
      </details>
      <details>
        <summary>Which monitoring tools work with Beacon?</summary>
        <p>Anything that can send a webhook. Datadog, Grafana, and most CI systems work out of the box, and our REST API covers the rest.</p>
      </details>
    </div>
  </div>
</section>

<section class="md-section md-section--tonal" aria-labelledby="waitlist-title" id="waitlist">
  <div class="md-section__inner">
    <div class="md-waitlist">
      <p class="md-section__eyebrow">Join the waitlist</p>
      <h2 id="waitlist-title" class="md-section__heading">Be first in line when Beacon opens.</h2>
      <p>Leave your email and we'll ping you the moment your team can join.</p>
      <%= form_with model: @lead, url: leads_path, class: "flex flex-col gap-6 items-start", data: { turbo: false } do |form| %>
        <div class="flex flex-col sm:flex-row gap-4 w-full max-w-xl">
          <div class="flex flex-col gap-1 flex-1">
            <%= form.label :name, "Name (optional)", class: "text-sm font-medium text-md-on-surface-variant" %>
            <%= form.text_field :name, autocomplete: "name", placeholder: "Ada Lovelace", class: "rounded-md border border-md-outline bg-md-surface px-3 py-2 text-md-on-surface placeholder:text-md-on-surface-variant focus:border-md-primary focus:ring-1 focus:ring-md-primary" %>
          </div>
          <div class="flex flex-col gap-1 flex-1">
            <%= form.label :email, "Work email", class: "text-sm font-medium text-md-on-surface-variant" %>
            <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "ada@northwind.dev", class: "rounded-md border border-md-outline bg-md-surface px-3 py-2 text-md-on-surface placeholder:text-md-on-surface-variant focus:border-md-primary focus:ring-1 focus:ring-md-primary" %>
          </div>
        </div>
        <%= form.submit "Join the waitlist", class: "md-button md-button--filled" %>
      <% end %>
    </div>
  </div>
</section>
